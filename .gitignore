*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.tflite
*.pkl
*.joblib
/models/checkpoints/

# Local IDE and operating-system artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python/test artifacts
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
